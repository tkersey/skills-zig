index 0000000..081aa3e
--- /dev/null
+++ b/src/main.zig
@@ -0,0 +1,36 @@
+const std = @import("std");
+const lib = @import("lib.zig");
+
+fn printCommandList(stdout: anytype) !void {
+    try stdout.print("seq bootstrap ready. commands:\n", .{});
+    for (lib.commandNames()) |def| {
+        try stdout.print("- {s}\n", .{def.name});
+    }
+}
+
+pub fn main() !void {
+    var args = std.process.args();
+    _ = args.next();
+
+    var stdout_writer = std.fs.File.stdout().writer(&.{});
+    const stdout = &stdout_writer.interface;
+
+    const arg = args.next() orelse {
+        try printCommandList(stdout);
+        return;
+    };
+
+    if (lib.isHelpArg(arg)) {
+        try printCommandList(stdout);
+        return;
+    }
+
+    const cmd = lib.parseCommand(arg);
+    switch (cmd) {
+        .unknown => {
+            try stdout.print("unknown command: {s}\n", .{arg});
+            return error.InvalidCommand;
+        },
+        else => try stdout.print("{s}: bootstrap placeholder\n", .{lib.commandName(cmd)}),
+    }
+}
