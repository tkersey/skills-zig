+fn rowFromEntries(allocator: std.mem.Allocator, entries: []const Entry) !Row {
+    var row = Row.init(allocator);
+    errdefer row.deinit();
+    for (entries) |entry| {
+        try row.put(entry.key, entry.value);
+    }
+    return row;
+}
