{
  "schema": "seq-observation-definition/v1",
  "id": "example/claude-session-exclusion",
  "requires": {"abi": "seq-observation-abi/v1", "operators": ["scan", "filter", "project"]},
  "parameters": {"exclude_session_id": {"type": "string", "required": true}},
  "selectors": ["path", "root", "session-id"],
  "relations": [
    {"name": "sessions", "fields": ["session_id", "lineage_conflict"]}
  ],
  "inputs": [],
  "pipeline": [
    {"op": "scan", "relation": "sessions", "as": "session_rows"},
    {
      "op": "filter", "input": "session_rows", "as": "kept",
      "where": [{"field": "session_id", "op": "ne", "param": "exclude_session_id"}]
    },
    {"op": "project", "input": "kept", "as": "rows", "fields": ["session_id", "lineage_conflict"]}
  ],
  "projections": {
    "rows": {
      "relation": "rows", "schema": "example/claude-session-exclusion/v1",
      "fields": ["session_id", "lineage_conflict"], "renderers": ["json"]
    }
  },
  "bounds": {"max_rows": 100, "max_output_bytes": 65536, "max_fold_states": 4}
}
