{
  "schema": "seq-observation-definition/v1",
  "id": "test/shared-fold",
  "requires": {
    "abi": "seq-observation-abi/v1",
    "operators": [
      "scan",
      "ordered-fold",
      "distinct",
      "join"
    ]
  },
  "parameters": {},
  "selectors": [
    "path"
  ],
  "relations": [
    {
      "name": "messages",
      "fields": [
        "role",
        "text"
      ]
    }
  ],
  "inputs": [],
  "pipeline": [
    {
      "op": "scan",
      "relation": "messages",
      "as": "source"
    },
    {
      "op": "ordered-fold",
      "input": "source",
      "as": "filtered",
      "keys": [],
      "order_by": [
        {
          "field": "role",
          "direction": "desc"
        }
      ],
      "state": [],
      "transitions": [],
      "emit": [
        {
          "name": "role",
          "type": "string",
          "nullable": true,
          "expr": {
            "field": "role"
          }
        }
      ]
    },
    {
      "op": "distinct",
      "input": "filtered",
      "as": "marker",
      "keys": [
        "role"
      ]
    },
    {
      "op": "join",
      "inputs": [
        "source",
        "marker"
      ],
      "as": "rows",
      "on": {
        "kind": "left",
        "keys": [
          {
            "left": "role",
            "right": "role"
          }
        ]
      },
      "fields": [
        {
          "source": 0,
          "field": "role",
          "name": "role",
          "type": "string",
          "nullable": true
        },
        {
          "source": 0,
          "field": "text",
          "name": "text",
          "type": "string",
          "nullable": true
        },
        {
          "source": 1,
          "field": "role",
          "name": "matched_role",
          "type": "string",
          "nullable": true
        }
      ]
    }
  ],
  "projections": {
    "rows": {
      "relation": "rows",
      "schema": "test/shared-input-result/v1",
      "fields": [
        "role",
        "text",
        "matched_role"
      ],
      "renderers": [
        "json"
      ]
    }
  },
  "bounds": {
    "max_rows": 100,
    "max_output_bytes": 16384,
    "max_fold_states": 8
  }
}
