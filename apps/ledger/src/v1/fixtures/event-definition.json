{
  "schema": "ledger-artifact-definition/v1",
  "id": "example/events",
  "owner": "example",
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "atomic-transaction",
      "compare-and-append",
      "exact-object",
      "idempotency-key"
    ]
  },
  "parameters": {
    "request": {
      "type": "safe_identifier",
      "required": true
    }
  },
  "inputs": {
    "event": {
      "codec": "json",
      "max_bytes": 4096
    }
  },
  "canonicalization": {},
  "shape": {
    "rules": [
      {
        "op": "exact-object",
        "input": "event",
        "path": "",
        "keys": [
          "kind",
          "value"
        ]
      }
    ]
  },
  "constraints": [],
  "identity": {},
  "storage": {
    "kind": "event-log",
    "slots": {
      "events": {
        "path": "example/events.jsonl",
        "kind": "event-log",
        "codec": "jsonl",
        "max_bytes": 65536
      }
    }
  },
  "operations": {
    "append": {
      "op": "atomic-transaction",
      "effects": [
        {
          "op": "compare-and-append",
          "slot": "events",
          "input": "event",
          "idempotency_param": "request"
        }
      ]
    }
  },
  "projections": {},
  "diagnostics": {},
  "bounds": {
    "max_input_bytes": 4096,
    "max_store_bytes": 65536,
    "max_records": 100,
    "max_output_bytes": 4096,
    "max_diagnostics": 16,
    "max_reducer_states": 16
  }
}
