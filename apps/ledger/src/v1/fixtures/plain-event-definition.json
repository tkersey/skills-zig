{
  "schema": "ledger-artifact-definition/v1",
  "id": "example/plain-protocol",
  "owner": "example",
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "append-only-log",
      "bind-existing",
      "compare-and-append",
      "event-kinds",
      "exact-object",
      "fold",
      "reducer",
      "replay",
      "transition-table"
    ]
  },
  "parameters": {},
  "inputs": {
    "event": {
      "codec": "json",
      "max_bytes": 4096
    }
  },
  "canonicalization": {},
  "shape": {
    "rules": [
      {
        "op": "exact-object",
        "input": "event",
        "path": "",
        "keys": [
          "kind",
          "value"
        ]
      },
      {
        "op": "exact-object",
        "input": "event",
        "path": "/value",
        "keys": [
          "id",
          "revision"
        ]
      }
    ]
  },
  "constraints": [
    {
      "op": "append-only-log",
      "input": "event"
    },
    {
      "op": "event-kinds",
      "values": [
        "created",
        "updated"
      ]
    },
    {
      "op": "reducer",
      "key": "/value/id",
      "on": "/kind",
      "event_kind": "/kind",
      "retain_once": "/value"
    },
    {
      "op": "transition-table",
      "states": [
        "current"
      ],
      "transitions": [
        {
          "from": null,
          "on": "created",
          "to": "current"
        },
        {
          "from": "current",
          "on": "updated",
          "to": "current"
        }
      ]
    }
  ],
  "identity": {},
  "storage": {
    "kind": "event-log",
    "slots": {
      "events": {
        "path": "example/plain.jsonl",
        "kind": "event-log",
        "codec": "jsonl",
        "max_bytes": 65536
      }
    }
  },
  "operations": {
    "append": {
      "effects": [
        {
          "op": "compare-and-append",
          "slot": "events",
          "input": "event"
        }
      ]
    },
    "bind-existing": {
      "effects": [
        {
          "op": "bind-existing",
          "slot": "events",
          "input": "event"
        }
      ]
    }
  },
  "projections": {
    "current": {
      "slot": "events",
      "pipeline": [
        {
          "op": "fold",
          "key_field": "id",
          "state_field": "status",
          "retained_field": "current",
          "event_count_field": "event_count"
        }
      ]
    }
  },
  "bounds": {
    "max_input_bytes": 4096,
    "max_store_bytes": 65536,
    "max_records": 4,
    "max_output_bytes": 4096,
    "max_diagnostics": 8,
    "max_reducer_states": 4
  }
}
