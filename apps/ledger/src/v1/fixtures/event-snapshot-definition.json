{
  "schema": "ledger-artifact-definition/v1",
  "id": "example/event-snapshot",
  "owner": "example",
  "requires": {
    "abi": "ledger-artifact-abi/v1",
    "operators": [
      "compare-and-replace",
      "create-new",
      "idempotency-key",
      "limit",
      "select"
    ]
  },
  "parameters": {
    "request": {
      "type": "safe_identifier",
      "required": false
    }
  },
  "inputs": {
    "snapshot": {
      "codec": "jsonl",
      "max_bytes": 4096
    }
  },
  "canonicalization": {},
  "shape": {},
  "constraints": [],
  "identity": {},
  "storage": {
    "kind": "event-log",
    "slots": {
      "events": {
        "path": "example/snapshots.jsonl",
        "kind": "event-log",
        "codec": "jsonl",
        "max_bytes": 4096
      }
    }
  },
  "operations": {
    "create": {
      "effects": [
        {
          "op": "create-new",
          "slot": "events",
          "input": "snapshot"
        }
      ]
    },
    "replace": {
      "effects": [
        {
          "op": "compare-and-replace",
          "slot": "events",
          "input": "snapshot",
          "idempotency_param": "request"
        }
      ]
    }
  },
  "projections": {
    "all": {
      "slot": "events",
      "pipeline": [
        {
          "op": "select",
          "fields": {
            "kind": "/kind",
            "value": "/value"
          }
        },
        {
          "op": "limit",
          "count": 10
        }
      ]
    }
  },
  "diagnostics": {},
  "bounds": {
    "max_input_bytes": 4096,
    "max_store_bytes": 4096,
    "max_records": 10,
    "max_output_bytes": 4096,
    "max_diagnostics": 16,
    "max_reducer_states": 4
  }
}
