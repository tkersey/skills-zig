{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memory-note append input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "authority",
    "summary",
    "scope",
    "source_refs",
    "payload"
  ],
  "properties": {
    "operation": {
      "enum": ["assert", "confirm", "supersede", "retract", "reject", "reopen"]
    },
    "authority": {"type": "string", "minLength": 1, "maxLength": 128},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repo", "paths"],
      "properties": {
        "kind": {
          "enum": ["global", "repo", "path-family", "task-family", "workflow", "tool"]
        },
        "repo": {"type": ["string", "null"]},
        "paths": {
          "type": "array",
          "maxItems": 128,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "summary"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "related_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "supersedes_id": {
      "type": ["string", "null"],
      "default": null
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
    },
    "payload": {"type": "object", "minProperties": 1}
  }
}
